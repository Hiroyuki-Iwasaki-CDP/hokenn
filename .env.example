# このファイルは変数名のみを示すサンプルです。実際の値はここにもGitにも書かないでください。
# Vercelにデプロイする場合は Vercel プロジェクトの Settings > Environment Variables に設定します。
# ローカルで `vercel dev` を使う場合は `.env.local` にコピーして値を入れてください(.env.local はコミットしない)。

# Supabaseプロジェクトの Project URL (Settings > API)
SUPABASE_URL=

# Supabaseプロジェクトの anon / public key (Settings > API)
SUPABASE_ANON_KEY=

# Supabaseプロジェクトの service_role key (Settings > API)
# 絶対にブラウザへ渡さない。サーバー(Vercel Functions)からのみ使用する。
SUPABASE_SERVICE_ROLE_KEY=

# レート制限記録(rate_limit_events)でメールアドレス/IPをハッシュ化するための秘密鍵。
# ランダムな長い文字列を生成して設定する(例: openssl rand -hex 32)。
RATE_LIMIT_HASH_SECRET=

# 本番公開URL(例: https://your-app.vercel.app)。CSRF対策のOriginチェックに使用する。
ALLOWED_ORIGIN=

# 公開ページに表示する運営者名・問い合わせメール（ブラウザへ公開される値）。
VITE_OPERATOR_NAME=
VITE_SUPPORT_EMAIL=

# LINE LoginチャネルのチャネルIDとチャネルシークレット。
# シークレットはサーバーのみで使用し、VITE_を付けない。
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LINE Developers Consoleの「LINEログイン設定」に登録するコールバックURL。
# 本番: https://hokenn.vercel.app/api/auth/line/callback
LINE_LOGIN_CALLBACK_URL=

# Messaging APIのWebhook署名検証と応答メッセージ送信に使用するサーバー専用値。
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
